\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Physical PVB profiles and divergence in the singular limit $w_0 \to 0$. (a) Radial intensity profiles $I(r)$ for ring waists $w_0 \in [0.02, 1.0]\,\text  {mm}$ ($r_0 = 1.0\,\text  {mm}$, $P = 1.0\,\text  {W}$, $l=1$). (b) Peak intensity divergence $I_{\max } \propto 1/w_0$ with dielectric breakdown threshold ($1.2 \times 10^4\,\text  {W/mm}^2$). (c) Topological radial shift $\Delta r_l$ vs $l$ for multiple $w_0$, comparing exact numerical maximization against the analytical formula $\Delta r_l \approx (4l^2 - 1)w_0^2 / (32 r_0)$.}}{11}{figure.1}\protected@file@percent }
\newlabel{fig:profiles_divergence}{{1}{11}{Physical PVB profiles and divergence in the singular limit $w_0 \to 0$. (a) Radial intensity profiles $I(r)$ for ring waists $w_0 \in [0.02, 1.0]\,\text {mm}$ ($r_0 = 1.0\,\text {mm}$, $P = 1.0\,\text {W}$, $l=1$). (b) Peak intensity divergence $I_{\max } \propto 1/w_0$ with dielectric breakdown threshold ($1.2 \times 10^4\,\text {W/mm}^2$). (c) Topological radial shift $\Delta r_l$ vs $l$ for multiple $w_0$, comparing exact numerical maximization against the analytical formula $\Delta r_l \approx (4l^2 - 1)w_0^2 / (32 r_0)$}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Exact radial inner product and asymptotic cross-talk matrix. (a) Exact overlap matrix heatmap $\gamma _l(r_1, r_2; w_0)$ from Eq.~\eqref  {eq:normalized_overlap} for $w_0 = 0.15\,\text  {mm}$ across radii $r_1, r_2 \in [0.4, 2.0]\,\text  {mm}$ ($l=1$). (b) Universal asymptotic Gaussian cross-talk heatmap from Eq.~\eqref  {eq:asymptotic_overlap}. (c) Relative approximation error heatmap $|\gamma _{\text  {exact}} - \gamma _{\text  {asymp}}| / \gamma _{\text  {exact}}$ showing $< 10^{-3}$ relative error throughout the physical thin-ring operating regime.}}{12}{figure.2}\protected@file@percent }
\newlabel{fig:overlap_matrix}{{2}{12}{Exact radial inner product and asymptotic cross-talk matrix. (a) Exact overlap matrix heatmap $\gamma _l(r_1, r_2; w_0)$ from Eq.~\eqref {eq:normalized_overlap} for $w_0 = 0.15\,\text {mm}$ across radii $r_1, r_2 \in [0.4, 2.0]\,\text {mm}$ ($l=1$). (b) Universal asymptotic Gaussian cross-talk heatmap from Eq.~\eqref {eq:asymptotic_overlap}. (c) Relative approximation error heatmap $|\gamma _{\text {exact}} - \gamma _{\text {asymp}}| / \gamma _{\text {exact}}$ showing $< 10^{-3}$ relative error throughout the physical thin-ring operating regime}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Continuous frame spectrum and paraxial frame bounds. (a) Continuous frame spectrum $\sigma (k_r) = \exp (-w_0^2 k_r^2 / 2)$ vs spatial frequency $k_r$ for multiple ring waists $w_0$, highlighting the paraxial cutoff $K_{\max }$. (b) Frame bounds $A, B$ and condition number $\kappa = B / A$ vs optical numerical aperture $\text  {NA} \in [0.01, 0.15]$ ($w_0 = 0.2\,\text  {mm}$, $\lambda = 1550\,\text  {nm}$). (c) Concentric multi-ring Gram singular values $\lambda _n$ for $M = 12$ concentric PVB rings across varying ring separations $\Delta r / w_0$, demonstrating strictly positive eigenvalues and stable condition numbers.}}{12}{figure.3}\protected@file@percent }
\newlabel{fig:frame_bounds}{{3}{12}{Continuous frame spectrum and paraxial frame bounds. (a) Continuous frame spectrum $\sigma (k_r) = \exp (-w_0^2 k_r^2 / 2)$ vs spatial frequency $k_r$ for multiple ring waists $w_0$, highlighting the paraxial cutoff $K_{\max }$. (b) Frame bounds $A, B$ and condition number $\kappa = B / A$ vs optical numerical aperture $\text {NA} \in [0.01, 0.15]$ ($w_0 = 0.2\,\text {mm}$, $\lambda = 1550\,\text {nm}$). (c) Concentric multi-ring Gram singular values $\lambda _n$ for $M = 12$ concentric PVB rings across varying ring separations $\Delta r / w_0$, demonstrating strictly positive eigenvalues and stable condition numbers}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Turbulence mitigation via RKHS projective filtering. (a) 2D Kolmogorov phase screen realization $\phi (x, y)$ ($C_n^2 = 10^{-14}\,\text  {m}^{-2/3}$, $z = 1\,\text  {km}$, $\lambda = 1550\,\text  {nm}$) with superimposed circular PVB ring trajectory ($r_0 = 1\,\text  {mm}$). (b) Modal crosstalk comparison (LG vs PVB), demonstrating superior radius locking and reduced scintillation variance. (c) RKHS reconstruction error vs noise standard deviation before and after projection $P_{\text  {RKHS}} = \mathcal  {T} S_w^{-1} \mathcal  {T}^*$, showing substantial out-of-subspace noise suppression.}}{12}{figure.4}\protected@file@percent }
\newlabel{fig:turbulence_recovery}{{4}{12}{Turbulence mitigation via RKHS projective filtering. (a) 2D Kolmogorov phase screen realization $\phi (x, y)$ ($C_n^2 = 10^{-14}\,\text {m}^{-2/3}$, $z = 1\,\text {km}$, $\lambda = 1550\,\text {nm}$) with superimposed circular PVB ring trajectory ($r_0 = 1\,\text {mm}$). (b) Modal crosstalk comparison (LG vs PVB), demonstrating superior radius locking and reduced scintillation variance. (c) RKHS reconstruction error vs noise standard deviation before and after projection $P_{\text {RKHS}} = \mathcal {T} S_w^{-1} \mathcal {T}^*$, showing substantial out-of-subspace noise suppression}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces High-dimensional quantum advantages of overcomplete PVB frames. (a) State tomography MSE vs photon count $N$ for qudit dimension $d=8$, comparing overcomplete continuous POVM against mutually unbiased bases (MUBs). (b) SPDC Bell--CHSH parameter $S$ vs iris aperture radius ratio $R_{\text  {iris}} / r_0$, demonstrating total entanglement preservation ($S = 2\sqrt  {2}$) for PVBs versus complete entanglement collapse for LG modes. (c) High-dimensional QKD secret key rate vs distance in graded-index ring-core fiber (GRIN-RCF) for $d=4$ and $d=8$, incorporating the 8.6~dB PVB coupling advantage.}}{13}{figure.5}\protected@file@percent }
\newlabel{fig:quantum_povm}{{5}{13}{High-dimensional quantum advantages of overcomplete PVB frames. (a) State tomography MSE vs photon count $N$ for qudit dimension $d=8$, comparing overcomplete continuous POVM against mutually unbiased bases (MUBs). (b) SPDC Bell--CHSH parameter $S$ vs iris aperture radius ratio $R_{\text {iris}} / r_0$, demonstrating total entanglement preservation ($S = 2\sqrt {2}$) for PVBs versus complete entanglement collapse for LG modes. (c) High-dimensional QKD secret key rate vs distance in graded-index ring-core fiber (GRIN-RCF) for $d=4$ and $d=8$, incorporating the 8.6~dB PVB coupling advantage}{figure.5}{}}
