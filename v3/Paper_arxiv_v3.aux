\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Physical PVB profiles and divergence in the singular limit $w_0 \to 0$. (a) Radial intensity profiles $I(r)$ for ring waists $w_0 \in [0.02, 1.0]\,\text  {mm}$ ($R_0 = 1.0\,\text  {mm}$, $P = 1.0\,\text  {W}$, $\ell =1$). (b) Topological radial shift $\Delta R_\ell $ vs $\ell $, comparing exact numerical maximization against the analytical formula $\Delta R_\ell \approx (4\ell ^2 - 1)w_0^2 / (32 R_0)$. (c) Peak intensity divergence $I_{\max } \propto 1/w_0$ with dielectric air breakdown threshold ($1.2 \times 10^4\,\text  {W/mm}^2$). (d) Concurrent divergence of transverse wavevector variance $\langle k_\perp ^2 \rangle \sim 1/w_0^2$ and $M^2 \sim 2 R_0 / w_0$.}}{20}{figure.1}\protected@file@percent }
\newlabel{fig:profiles_divergence}{{1}{20}{Physical PVB profiles and divergence in the singular limit $w_0 \to 0$. (a) Radial intensity profiles $I(r)$ for ring waists $w_0 \in [0.02, 1.0]\,\text {mm}$ ($R_0 = 1.0\,\text {mm}$, $P = 1.0\,\text {W}$, $\ell =1$). (b) Topological radial shift $\Delta R_\ell $ vs $\ell $, comparing exact numerical maximization against the analytical formula $\Delta R_\ell \approx (4\ell ^2 - 1)w_0^2 / (32 R_0)$. (c) Peak intensity divergence $I_{\max } \propto 1/w_0$ with dielectric air breakdown threshold ($1.2 \times 10^4\,\text {W/mm}^2$). (d) Concurrent divergence of transverse wavevector variance $\langle k_\perp ^2 \rangle \sim 1/w_0^2$ and $M^2 \sim 2 R_0 / w_0$}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Exact radial inner product and asymptotic cross-talk matrix across ring radii. (a) Exact overlap matrix heatmap $\gamma _\ell (R_1, R_2; w_0)$ from Eq.~\eqref  {eq:normalized_overlap} for $w_0 = 0.15\,\text  {mm}$ across radii $R_1, R_2 \in [0.4, 2.0]\,\text  {mm}$ ($\ell =1$). (b) Universal asymptotic Gaussian cross-talk heatmap from Eq.~\eqref  {eq:asymptotic_overlap}. (c) Logarithmic absolute error heatmap $\log _{10} |\gamma _{\text  {exact}} - \gamma _{\text  {asymp}}|$, demonstrating $< 10^{-4}$ discrepancy throughout the physical operating regime. (d) Kronecker azimuthal orthogonality confirmation: $\langle \psi _{\ell _1, R_0} | \psi _{\ell _2, R_0} \rangle = \delta _{\ell _1, \ell _2}$ across $\ell _1, \ell _2 \in [-5, 5]$.}}{21}{figure.2}\protected@file@percent }
\newlabel{fig:overlap_matrix}{{2}{21}{Exact radial inner product and asymptotic cross-talk matrix across ring radii. (a) Exact overlap matrix heatmap $\gamma _\ell (R_1, R_2; w_0)$ from Eq.~\eqref {eq:normalized_overlap} for $w_0 = 0.15\,\text {mm}$ across radii $R_1, R_2 \in [0.4, 2.0]\,\text {mm}$ ($\ell =1$). (b) Universal asymptotic Gaussian cross-talk heatmap from Eq.~\eqref {eq:asymptotic_overlap}. (c) Logarithmic absolute error heatmap $\log _{10} |\gamma _{\text {exact}} - \gamma _{\text {asymp}}|$, demonstrating $< 10^{-4}$ discrepancy throughout the physical operating regime. (d) Kronecker azimuthal orthogonality confirmation: $\langle \psi _{\ell _1, R_0} | \psi _{\ell _2, R_0} \rangle = \delta _{\ell _1, \ell _2}$ across $\ell _1, \ell _2 \in [-5, 5]$}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Continuous frame spectrum and paraxial frame bounds. (a) Continuous frame spectrum $\sigma (k_r) = \exp (-w_0^2 k_r^2 / 2)$ vs spatial frequency $k_r$ for multiple ring waists $w_0$, highlighting the paraxial cutoff $K_{\max }$. (b) Frame bounds $A, B$ and condition number $\kappa = B / A$ vs optical numerical aperture $\text  {NA} \in [0.01, 0.20]$ ($w_0 = 0.2\,\text  {mm}$, $\lambda = 1550\,\text  {nm}$). (c) Exact field reconstruction comparing smoothed projection $S_w \psi $ against canonical dual frame inversion $S_w^{-1}(S_w \psi ) = \psi $. (d) Concentric multi-ring Gram singular values $\lambda _n$ for $M = 12$ concentric PVB rings across varying ring separations $\Delta R / w_0$, demonstrating strictly positive eigenvalues and stable condition numbers.}}{22}{figure.3}\protected@file@percent }
\newlabel{fig:frame_bounds}{{3}{22}{Continuous frame spectrum and paraxial frame bounds. (a) Continuous frame spectrum $\sigma (k_r) = \exp (-w_0^2 k_r^2 / 2)$ vs spatial frequency $k_r$ for multiple ring waists $w_0$, highlighting the paraxial cutoff $K_{\max }$. (b) Frame bounds $A, B$ and condition number $\kappa = B / A$ vs optical numerical aperture $\text {NA} \in [0.01, 0.20]$ ($w_0 = 0.2\,\text {mm}$, $\lambda = 1550\,\text {nm}$). (c) Exact field reconstruction comparing smoothed projection $S_w \psi $ against canonical dual frame inversion $S_w^{-1}(S_w \psi ) = \psi $. (d) Concentric multi-ring Gram singular values $\lambda _n$ for $M = 12$ concentric PVB rings across varying ring separations $\Delta R / w_0$, demonstrating strictly positive eigenvalues and stable condition numbers}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Turbulence mitigation via RKHS projective filtering. (a) 2D Kolmogorov phase screen realization $\phi (x, y)$ ($C_n^2 = 10^{-14}\,\text  {m}^{-2/3}$, $z = 1\,\text  {km}$, $\lambda = 1550\,\text  {nm}$) with superimposed circular PVB ring trajectory ($R_0 = 1\,\text  {mm}$). (b) Intermodal cross-talk comparison (LG vs PVB), demonstrating superior radius locking and reduced scintillation variance. (c) RKHS reconstruction error vs noise standard deviation before and after projection $P_{\text  {RKHS}} = \mathcal  {T} S_w^{-1} \mathcal  {T}^*$, showing substantial out-of-subspace noise suppression. (d) Signal-to-noise ratio enhancement (in dB) achieved by RKHS passive projection as a function of propagation distance.}}{23}{figure.4}\protected@file@percent }
\newlabel{fig:turbulence_recovery}{{4}{23}{Turbulence mitigation via RKHS projective filtering. (a) 2D Kolmogorov phase screen realization $\phi (x, y)$ ($C_n^2 = 10^{-14}\,\text {m}^{-2/3}$, $z = 1\,\text {km}$, $\lambda = 1550\,\text {nm}$) with superimposed circular PVB ring trajectory ($R_0 = 1\,\text {mm}$). (b) Intermodal cross-talk comparison (LG vs PVB), demonstrating superior radius locking and reduced scintillation variance. (c) RKHS reconstruction error vs noise standard deviation before and after projection $P_{\text {RKHS}} = \mathcal {T} S_w^{-1} \mathcal {T}^*$, showing substantial out-of-subspace noise suppression. (d) Signal-to-noise ratio enhancement (in dB) achieved by RKHS passive projection as a function of propagation distance}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces High-dimensional quantum advantages of overcomplete PVB frames. (a) State tomography MSE vs detected photon count $N$ for qudit dimension $d=8$, comparing overcomplete continuous POVM against mutually unbiased bases (MUBs). (b) Quantum Fisher Information and Cram{\'e}r--Rao scaling, exhibiting $2.7\times $ lower MSE via frame redundancy. (c) Two-photon SPDC Bell--CHSH parameter $S$ vs iris aperture radius ratio $R_{\text  {iris}} / R_0$, demonstrating total entanglement preservation ($S = 2\sqrt  {2}$) for PVBs versus complete entanglement collapse for LG modes. (d) High-dimensional QKD secret key rate vs distance in graded-index ring-core fiber (GRIN-RCF) for $d=4$ and $d=8$, incorporating the 8.6~dB PVB coupling advantage.}}{24}{figure.5}\protected@file@percent }
\newlabel{fig:quantum_povm}{{5}{24}{High-dimensional quantum advantages of overcomplete PVB frames. (a) State tomography MSE vs detected photon count $N$ for qudit dimension $d=8$, comparing overcomplete continuous POVM against mutually unbiased bases (MUBs). (b) Quantum Fisher Information and Cram{\'e}r--Rao scaling, exhibiting $2.7\times $ lower MSE via frame redundancy. (c) Two-photon SPDC Bell--CHSH parameter $S$ vs iris aperture radius ratio $R_{\text {iris}} / R_0$, demonstrating total entanglement preservation ($S = 2\sqrt {2}$) for PVBs versus complete entanglement collapse for LG modes. (d) High-dimensional QKD secret key rate vs distance in graded-index ring-core fiber (GRIN-RCF) for $d=4$ and $d=8$, incorporating the 8.6~dB PVB coupling advantage}{figure.5}{}}
