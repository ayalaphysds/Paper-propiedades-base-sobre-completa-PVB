\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Physical PVB profiles and divergence in the singular limit $w_0 \to 0$. (a) Radial intensity profiles $I(r)$ for ring waists $w_0 \in [0.02, 1.0]\,\text  {mm}$ ($R_0 = 1.0\,\text  {mm}$, $P = 1.0\,\text  {W}$, $\ell =1$). (b) Topological radial shift $\Delta R_\ell $ vs $\ell $, comparing exact numerical maximization against the analytical formula $\Delta R_\ell \approx (4\ell ^2 - 1)w_0^2 / (32 R_0)$. (c) Peak intensity divergence $I_{\max } \propto 1/w_0$ with dielectric air breakdown threshold ($1.2 \times 10^4\,\text  {W/mm}^2$). (d) Concurrent divergence of transverse wavevector variance $\langle k_\perp ^2 \rangle \sim 1/w_0^2$ and $M^2 \sim 2 R_0 / w_0$.}}{21}{figure.caption.16}\protected@file@percent }
\newlabel{fig:profiles_divergence}{{1}{21}{Physical PVB profiles and divergence in the singular limit $w_0 \to 0$. (a) Radial intensity profiles $I(r)$ for ring waists $w_0 \in [0.02, 1.0]\,\text {mm}$ ($R_0 = 1.0\,\text {mm}$, $P = 1.0\,\text {W}$, $\ell =1$). (b) Topological radial shift $\Delta R_\ell $ vs $\ell $, comparing exact numerical maximization against the analytical formula $\Delta R_\ell \approx (4\ell ^2 - 1)w_0^2 / (32 R_0)$. (c) Peak intensity divergence $I_{\max } \propto 1/w_0$ with dielectric air breakdown threshold ($1.2 \times 10^4\,\text {W/mm}^2$). (d) Concurrent divergence of transverse wavevector variance $\langle k_\perp ^2 \rangle \sim 1/w_0^2$ and $M^2 \sim 2 R_0 / w_0$}{figure.caption.16}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Exact radial inner product and asymptotic cross-talk matrix across ring radii. (a) Exact overlap matrix heatmap $\gamma _\ell (R_1, R_2; w_0)$ from Eq.~\eqref  {eq:normalized_overlap} for $w_0 = 0.15\,\text  {mm}$ across radii $R_1, R_2 \in [0.4, 2.0]\,\text  {mm}$ ($\ell =1$). (b) Universal asymptotic Gaussian cross-talk heatmap from Eq.~\eqref  {eq:asymptotic_overlap}. (c) Logarithmic absolute error heatmap $\log _{10} |\gamma _{\text  {exact}} - \gamma _{\text  {asymp}}|$, demonstrating $< 10^{-4}$ discrepancy throughout the physical operating regime. (d) Kronecker azimuthal orthogonality confirmation: $\langle \psi _{\ell _1, R_0} | \psi _{\ell _2, R_0} \rangle = \delta _{\ell _1, \ell _2}$ across $\ell _1, \ell _2 \in [-5, 5]$.}}{22}{figure.caption.17}\protected@file@percent }
\newlabel{fig:overlap_matrix}{{2}{22}{Exact radial inner product and asymptotic cross-talk matrix across ring radii. (a) Exact overlap matrix heatmap $\gamma _\ell (R_1, R_2; w_0)$ from Eq.~\eqref {eq:normalized_overlap} for $w_0 = 0.15\,\text {mm}$ across radii $R_1, R_2 \in [0.4, 2.0]\,\text {mm}$ ($\ell =1$). (b) Universal asymptotic Gaussian cross-talk heatmap from Eq.~\eqref {eq:asymptotic_overlap}. (c) Logarithmic absolute error heatmap $\log _{10} |\gamma _{\text {exact}} - \gamma _{\text {asymp}}|$, demonstrating $< 10^{-4}$ discrepancy throughout the physical operating regime. (d) Kronecker azimuthal orthogonality confirmation: $\langle \psi _{\ell _1, R_0} | \psi _{\ell _2, R_0} \rangle = \delta _{\ell _1, \ell _2}$ across $\ell _1, \ell _2 \in [-5, 5]$}{figure.caption.17}{}}
