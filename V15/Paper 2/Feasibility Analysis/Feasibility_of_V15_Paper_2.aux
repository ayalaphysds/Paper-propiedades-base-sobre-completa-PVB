\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Key V15 Paper~2 feasibility proofs. (a)~Kolmogorov turbulence field MSE across $D/r_0 \in [0.5,3.0]$ showing the $N=5$ PVB dual-frame projector outperforming not only isotropic Tikhonov filtering but also an optimally waist-tuned matched-dimension $N=5$ $\mathrm  {LG}_{p,1}$ radial projector. (b)~Worst-case single-photon iris transmission $\min (t_1,t_4)$ vs.\ $R_{\mathrm  {iris}}/R_0$, showing PVB clearing the $82.84\%$ CHSH detection-loophole threshold at $1.048\,R_0$ while even $l=4$-matched LG requires $1.324\,R_0$.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:p2_feas}{{1}{3}{Key V15 Paper~2 feasibility proofs. (a)~Kolmogorov turbulence field MSE across $D/r_0 \in [0.5,3.0]$ showing the $N=5$ PVB dual-frame projector outperforming not only isotropic Tikhonov filtering but also an optimally waist-tuned matched-dimension $N=5$ $\mathrm {LG}_{p,1}$ radial projector. (b)~Worst-case single-photon iris transmission $\min (t_1,t_4)$ vs.\ $R_{\mathrm {iris}}/R_0$, showing PVB clearing the $82.84\%$ CHSH detection-loophole threshold at $1.048\,R_0$ while even $l=4$-matched LG requires $1.324\,R_0$}{figure.1}{}}
